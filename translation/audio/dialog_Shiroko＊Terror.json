            "CharacterId": 10100,
            "DialogCategory": "UILobby",
            "VoiceClip": "Shiroko＊Terror_Lobby_1_2",
            "Path": "Audio/VOC_JP/JP_CH0263/CH0263_Lobby_1_2",
            "LocalizeEN": "...Because I've done it before."
