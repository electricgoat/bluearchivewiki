        },
        {
            "CharacterId": 10064,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Kayoko_(New_Year)_ExSkill_Level_3",
            "Path": "Audio/VOC_JP/JP_CH0086/ch0086_exskill_level_3",
            "LocalizeEN": "May this year be a good one."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "Growup",
            "VoiceClip": "Kayoko_(New_Year)_Growup_1",
            "Path": "Audio/VOC_JP/JP_CH0086/ch0086_growup_1",
            "LocalizeEN": "Well, thank you. I'll be with Sensei again this year... right?"
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "Growup",
            "VoiceClip": "Kayoko_(New_Year)_Growup_2",
            "Path": "Audio/VOC_JP/JP_CH0086/ch0086_growup_2",
            "LocalizeEN": "I'm not sure if I can live up to your expectations, but... I'll do my best."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "Growup",
            "VoiceClip": "Kayoko_(New_Year)_Growup_3",
            "Path": "Audio/VOC_JP/JP_CH0086/ch0086_growup_3",
            "LocalizeEN": "What kind of face should I make right now...? Sorry, I'm not used to this kind of situation."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "Growup",
            "VoiceClip": "Kayoko_(New_Year)_Growup_4",
            "Path": "Audio/VOC_JP/JP_CH0086/ch0086_growup_4",
            "LocalizeEN": "I always receive so much from Sensei. I'm not sure if I can ever properly repay you, but I'll do my best."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "Relationship",
            "VoiceClip": "Kayoko_(New_Year)_Relationship_Up_1",
            "Path": "Audio/VOC_JP/JP_CH0086/ch0086_relationship_up_1",
            "LocalizeEN": "It's wonderful how bonds can form between people who care deeply for each other."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "Relationship",
            "VoiceClip": "Kayoko_(New_Year)_Relationship_Up_2",
            "Path": "Audio/VOC_JP/JP_CH0086/ch0086_relationship_up_2",
            "LocalizeEN": "Um, I don't usually say this kind of thing, but I'm glad you're here, Sensei."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "Relationship",
            "VoiceClip": "Kayoko_(New_Year)_Relationship_Up_3",
            "Path": "Audio/VOC_JP/JP_CH0086/ch0086_relationship_up_3",
            "LocalizeEN": "I've always wondered what it would feel like to ring in the New Year with Sensei, but now I think I have a bit of an idea."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "Relationship",
            "VoiceClip": "Kayoko_(New_Year)_Relationship_Up_4",
            "Path": "Audio/VOC_JP/JP_CH0086/ch0086_relationship_up_4",
            "LocalizeEN": "Thank you for saying it suits me, although I guess it's just flattery. Is it not flattery...? Wait, Sensei. That's unfair."
        }
    ]
