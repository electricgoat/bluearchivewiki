{
    "DataList": [
        {
            "CharacterId": 10064,
            "DialogCategory": "CharacterGet",
            "VoiceClip": "Kayoko_(New_Year)_Gachaget",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_Gachaget",
            "LocalizeEN": "What? It's New Year's. I just thought I should wear the right outfit to celebrate... Please keep looking after me this year too, Sensei."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "Cafe",
            "VoiceClip": "Kayoko_(New_Year)_Cafe_Monolog_1",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_Cafe_monolog_1",
            "LocalizeEN": "I hope next year will be safe, too...whatever that means."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kayoko_(New_Year)_Lobby_2",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_Lobby_2",
            "LocalizeEN": "Hah. That's more than enough teasing out of you, Sensei.\n\nWait, you...you mean it? Um, okay... I-I guess that's fine then..."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kayoko_(New_Year)_Lobby_5",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_Lobby_5",
            "LocalizeEN": "Even if it's not official business, if it's something you need, I'd try...\n\nUm, nevermind! Forget about it. I didn't say anything."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kayoko_(New_Year)_Season_Birthday",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_Season_Birthday",
            "LocalizeEN": "My...birthday?\n\nI didn't expect you to remember. Uh, not that that's bad. Actually, it's kind of nice to hear you wish me a happy birthday...\n\nSo, uh, thanks."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kayoko_(New_Year)_Season_NewYear",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_Season_NewYear",
            "LocalizeEN": "Happy New Year, Sensei. I hope you have another great year.\n\n...Pocket money? Really?"
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kayoko_(New_Year)_Season_Xmas",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_Season_Xmas",
            "LocalizeEN": "Oh, it is Christmas. New Year's is coming up soon, isn't it?\n\nAll in all...how was the year for you?"
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kayoko_(New_Year)_MemorialLobby_1",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_MemorialLobby_1",
            "LocalizeEN": "Oh. It's almost time for the first train."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kayoko_(New_Year)_MemorialLobby_3_1",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_MemorialLobby_3_1",
            "LocalizeEN": "The end-of-year bells are a special, annual event.\n\nThe first train's bell, on the other hand, is a boring sound commuters hear every morning. They probably don't even notice it anymore."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kayoko_(New_Year)_MemorialLobby_4_1",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_MemorialLobby_4_1",
            "LocalizeEN": "But the first day of the New Year only comes around once a year, you know?\n\nSo what's heard on this day, may actually be the best sound ever."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Kayoko_(New_Year)_EventLobby_1",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_EventLobby_1",
            "LocalizeEN": "Um... I hope you have a happy, peaceful year."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Kayoko_(New_Year)_EventLobby_2_2",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_EventLobby_2_2",
            "LocalizeEN": "I mean, I might've gone a little overboard.\n\nEh. It's worth it to see the boss smile."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Kayoko_(New_Year)_EventLogin_Season_2",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_EventLogin_Season_2",
            "LocalizeEN": "An offering thief...\n\nUgh...this seams like a pain. I don't really wanna...\n\nBut it's the boss' orders, so there's nothing I can do..."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "UIEventMission",
            "VoiceClip": "Kayoko_(New_Year)_EventMission_2",
            "Path": "Audio/VOC_JP/JP_CH0086/CH0086_EventMission_2",
            "LocalizeEN": "Sorry. I'm not like Mutsuki... I'm really not used to this kind of place.\n\nUm... I'm just not sure what to do with my face right now..."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "Formation",
            "VoiceClip": "Kayoko_(New_Year)_Formation_In_1",
            "Path": "Audio/VOC_JP/JP_CH0086/ch0086_formation_in_1",
            "LocalizeEN": "It's your turn? Understood."
        },
        {
            "CharacterId": 10064,
            "DialogCategory": "Formation",
            "VoiceClip": "Kayoko_(New_Year)_Formation_In_2",
            "Path": "Audio/VOC_JP/JP_CH0086/ch0086_formation_in_2",
            "LocalizeEN": "It suits me? I'm glad."
        },
