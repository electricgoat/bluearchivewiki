            "LocalizeEN": "Need to check before practice."
        },
        {
            "CharacterId": 10086,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Hina_(Dress)_ExSkill_1",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_exskill_1",
            "LocalizeJP": "あなたのために\n用意した旋律……",
            "LocalizeEN": "This melody is prepared for you."
        },
        {
            "CharacterId": 10086,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Hina_(Dress)_ExSkill_2",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_exskill_2",
