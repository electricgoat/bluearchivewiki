        },
        {
            "CharacterId": 10086,
            "DialogCategory": "Battle",
            "VoiceClip": "Hina_(Dress)_Battle_Move_1",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_battle_move_1",
