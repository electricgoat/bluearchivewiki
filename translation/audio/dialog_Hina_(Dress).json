        },
        {
            "CharacterId": 10086,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Hina_(Dress)_ExSkill_Level_3",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_exskill_level_3",
