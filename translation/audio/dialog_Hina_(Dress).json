        {
            "CharacterId": 10086,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Hina_(Dress)_ExSkill_Level_8",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_exskill_level_8",
            "LocalizeEN": "Elegante."
        },
        {
            "CharacterId": 10086,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Hina_(Dress)_ExSkill_Level_9",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_exskill_level_9",
            "LocalizeEN": "This is the finale."
        },
        {
            "CharacterId": 10086,
            "DialogCategory": "Growup",
            "VoiceClip": "Hina_(Dress)_Growup_1",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_growup_1",
            "LocalizeEN": "Thanks to Sensei, I advanced in an additional measure again. Thank you."
        },
        {
            "CharacterId": 10086,
            "DialogCategory": "Growup",
            "VoiceClip": "Hina_(Dress)_Growup_2",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_growup_2",
            "LocalizeEN": "Who I am now is thanks to Sensei. I'm really happy of that."
        },
        {
            "CharacterId": 10086,
            "DialogCategory": "Growup",
            "VoiceClip": "Hina_(Dress)_Growup_3",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_growup_3",
            "LocalizeEN": "I want to keep getting stronger to return a favor. Can you keep an eye on me?"
        },
        {
            "CharacterId": 10086,
            "DialogCategory": "Growup",
            "VoiceClip": "Hina_(Dress)_Growup_4",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_growup_4",
            "LocalizeEN": "Until Sensei can rely on me, I want to get stronger and grow. That is all what I think now."
        },
        {
            "CharacterId": 10086,
            "DialogCategory": "Relationship",
            "VoiceClip": "Hina_(Dress)_Relationship_Up_1",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_relationship_up_1",
            "LocalizeEN": "Sensei taught that even I was useful. Because you are, I am... Thank you so much."
        },
        {
            "CharacterId": 10086,
            "DialogCategory": "Relationship",
            "VoiceClip": "Hina_(Dress)_Relationship_Up_2",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_relationship_up_2",
            "LocalizeJP": "その……こんな格好だから。\nいつも以上に視線を気にしてしまうかも。\n相手が先生なら、いいんだけど……",
            "LocalizeEN": "Um... Because of this appearance, I might care about someone's gazes more. If Sensei's, I don't care."
        },
        {
            "CharacterId": 10086,
            "DialogCategory": "Relationship",
            "VoiceClip": "Hina_(Dress)_Relationship_Up_3",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_relationship_up_3",
            "LocalizeEN": "Even I, may be really here? ...Hehe, you really don't change. Thank you."
        },
        {
            "CharacterId": 10086,
            "DialogCategory": "Relationship",
            "VoiceClip": "Hina_(Dress)_Relationship_Up_4",
            "Path": "Audio/VOC_JP/JP_CH0230/ch0230_relationship_up_4",
            "LocalizeEN": "Sensei, can you hold my hand? If you can, my tension will be relieved a little."
        }
    ]
}
