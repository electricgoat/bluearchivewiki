            "DialogCategory": "Tactic",
            "VoiceClip": "Miyu_Tactic_Defeat_2",
            "Path": "Audio/VOC_JP/JP_CH0145/ch0145_tactic_defeat_2",
            "LocalizeJP": "逃げたい、辛い、帰りたい。",
            "LocalizeEN": "I want to run away, it hurts, I want to go home."
        },
        {
            "CharacterId": 10039,
            "DialogCategory": "Tactic",
