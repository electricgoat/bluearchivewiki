{
    "DataList": [
        {
            "CharacterId": 20009,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Cherino_(Hot_Spring)_EventLogin_Season_End",
            "Path": "Audio/VOC_JP/JP_CH0164/CH0164_EventLogin_Season_End",
            "LocalizeJP": "もうしばらく\n温泉はいいや……\n\nカムラッド、\n事務局に戻って休もう……\n\nカムラッド、\n事務局に戻って休もう……",
            "LocalizeEN": "I'm tired of the hot springs now, Comrade...\n\nComrade, I want to return to the Secretariat and rest...\n\nComrade, I want to return to the Secretariat and rest..."
        },
        {
            "CharacterId": 20009,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Cherino_(Hot_Spring)_EventLocation_1",
            "Path": "Audio/VOC_JP/JP_CH0164/ch0164_eventlocation_1",
            "LocalizeJP": "ほう、これが大浴場…。おいらの権威にふさわしい、立派な大きさで悪くないぞ。",
            "LocalizeEN": "Oh, is this the public bath? It's a nice size, befitting my authority, and it looks nice."
        },
        {
            "CharacterId": 20009,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Cherino_(Hot_Spring)_EventLocation_Act_1",
            "Path": "Audio/VOC_JP/JP_CH0164/ch0164_eventlocation_act_1",
            "LocalizeJP": "うう、どうしてこんな熱いお湯の中にずっと浸かってないとダメなんだ。",
            "LocalizeEN": "Ugh, why do I have to stay in such hot water for so long?"
        },
        {
            "CharacterId": 20009,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Cherino_(Hot_Spring)_EventLocation_Act_2",
            "Path": "Audio/VOC_JP/JP_CH0164/ch0164_eventlocation_act_2",
            "LocalizeJP": "ふむ、ここの温泉饅頭はいくつ食べても絶品だな。",
            "LocalizeEN": "Hmm, no matter how many hot spring manju I eat here, they are exquisite."
        },
        {
            "CharacterId": 20009,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Cherino_(Hot_Spring)_EventLocation_Act_3",
            "Path": "Audio/VOC_JP/JP_CH0164/ch0164_eventlocation_act_3",
            "LocalizeJP": "ちょっと退屈だな。",
            "LocalizeEN": "It's a little boring."
        },
        {
            "CharacterId": 20009,
            "DialogCategory": "Formation",
            "VoiceClip": "Cherino_(Hot_Spring)_Formation_In_1",
            "Path": "Audio/VOC_JP/JP_CH0164/ch0164_formation_in_1",
            "LocalizeJP": "ふふん、おいらに任せたまえ。",
            "LocalizeEN": "Leave it to me."
        },
        {
            "CharacterId": 20009,
            "DialogCategory": "Formation",
            "VoiceClip": "Cherino_(Hot_Spring)_Formation_In_2",
            "Path": "Audio/VOC_JP/JP_CH0164/ch0164_formation_in_2",
            "LocalizeJP": "おいらの出番か。",
            "LocalizeEN": "Is it my turn?"
        },
        {
            "CharacterId": 20009,
            "DialogCategory": "CommonSkill",
            "VoiceClip": "Cherino_(Hot_Spring)_CommonSkill",
            "Path": "Audio/VOC_JP/JP_CH0164/ch0164_commonskill",
