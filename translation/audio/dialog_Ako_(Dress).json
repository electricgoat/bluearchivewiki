{
    "DataList": [
        {
            "CharacterId": 10087,
            "DialogCategory": "Cafe",
            "VoiceClip": "Ako_(Dress)_Cafe_Monolog_4",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_Cafe_monolog_4",
            "LocalizeEN": "Phew. I hope there's no trouble. If only for today."
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UILobby",
            "VoiceClip": "Ako_(Dress)_Lobby_5_1",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_Lobby_5_1",
            "LocalizeEN": "Huh? I saved your life?\n\nI see... I'm happy to hear you're pleased with my assistance.\n\n...Although, I do wish you'd show appreciation for my talents more often."
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UILobby",
            "VoiceClip": "Ako_(Dress)_Season_Birthday_1",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_Season_Birthday_1",
            "LocalizeEN": "Oh my, are you congratulating me on my birthday?\n\nThank you. Hmm? \"Well seeing it's your birthday and all...\""
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UILobby",
            "VoiceClip": "Ako_(Dress)_Season_Birthday_2",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_Season_Birthday_2",
            "LocalizeEN": "\"You can ask me for a present.\" Is that so?\n\nHeehee... Are you sure about that, Sensei? You have no idea what I'll ask for..."
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Ako_(Dress)_MemorialLobby_1_1",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_MemorialLobby_1_1",
            "LocalizeEN": "Th-This is really bad! If someone else notices or comes around the corner...\n\nIt'll be huge trouble!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Ako_(Dress)_MemorialLobby_2_1",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_MemorialLobby_2_1",
            "LocalizeEN": "Wh-Why now of all times?!\n\nEspecially when I'm here with you, Sensei?!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Ako_(Dress)_MemorialLobby_4_1",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_MemorialLobby_4_1",
            "LocalizeEN": "Hm? Wh-What is it? What's with that look?\n\n...Really?\n\nWh-What is it? Is it a bug?"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Ako_(Dress)_MemorialLobby_5_1",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_MemorialLobby_5_1",
            "LocalizeEN": "Th-That's, uh... Returning...purchases tends to be a lot of effort...\n\nAnd...I had so much Prefect Team business...\n\nLook, I just couldn't be bothered... It is what it is! Let's just leave it at that!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Ako_(Dress)_EventLogin_1",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_EventLogin_1",
            "LocalizeEN": "Welcome, Sensei.\n\nAre you ready?\n\nBe prepared. Stay strong."
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Ako_(Dress)_EventLogin_2",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_EventLogin_2",
            "LocalizeEN": "All the proper preparations are in place.\n\nAs the Chief Officer of Gehenna's Prefect Team...\n\nNow is the time to take a stand."
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Ako_(Dress)_EventLogin_Season_1",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_EventLogin_Season_1",
            "LocalizeEN": "You're saying that \"this won't be resolved easily?\"\n\nWell, I can't simply give up."
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Ako_(Dress)_EventLogin_Season_End",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_EventLogin_Season_End",
            "LocalizeEN": "It's finally over...\n\nWow. There really was a lot going on today...\n\nIt feels like all the tension has been completely drained out of me.\n\n...Would you like to head back and grab a cup of coffee or something, Sensei?"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Ako_(Dress)_EventLobby_1",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_EventLobby_1",
            "LocalizeEN": "As for the party...\n\nI wonder how this all is going to turn out?"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Ako_(Dress)_EventLobby_2",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_EventLobby_2",
            "LocalizeEN": "Well, it doesn't matter...\n\nWhatever happens, the Prefect Team...\n\nNo, I will be there to solve it!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Ako_(Dress)_EventLobby_3",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_EventLobby_3",
            "LocalizeEN": "Right now, I'm just a spy backing Head Prefect Hina.\n\nI've been holding back. Maybe it's time that I showed off my true skills.\n\nHeehee. Look forward to it."
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Ako_(Dress)_EventLobby_4",
            "Path": "Audio/VOC_JP/JP_CH0231/CH0231_EventLobby_4",
            "LocalizeEN": "And here I thought it would be quiet this year...\n\nBut, I guess it'd be too much to ask for in Gehenna. Phew."
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Formation",
            "VoiceClip": "Ako_(Dress)_Formation_In_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_formation_in_1",
            "LocalizeEN": "Yes! Let's go, shall we"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Formation",
            "VoiceClip": "Ako_(Dress)_Formation_In_2",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_formation_in_2",
            "LocalizeEN": "Leave it to me"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Formation",
            "VoiceClip": "Ako_(Dress)_Formation_Select",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_formation_select",
            "LocalizeEN": "If there i something you need please let me know"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Tactic",
            "VoiceClip": "Ako_(Dress)_Tactic_Defeat_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_tactic_defeat_1",
            "LocalizeJP": "作戦、失敗ですって…！？一体、なにが…？",
            "LocalizeEN": "The plan, failed..!? What, couldve been..?"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Tactic",
            "VoiceClip": "Ako_(Dress)_Tactic_Defeat_2",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_tactic_defeat_2",
            "LocalizeJP": "うう、今回は失敗してしまいましたが…私は諦めません…！",
            "LocalizeEN": "Ugh, it's a failure this time but... I am not giving up..!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Tactic",
            "VoiceClip": "Ako_(Dress)_Tactic_In_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_tactic_in_1",
            "LocalizeEN": "Yes, operation start. Sensei, I'm counting on you for orders"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Tactic",
            "VoiceClip": "Ako_(Dress)_Tactic_In_2",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_tactic_in_2",
            "LocalizeEN": "I'll go to the site myself. I'm counting on you for support"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Tactic",
            "VoiceClip": "Ako_(Dress)_Tactic_Victory_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_tactic_victory_1",
            "LocalizeEN": "Oh, what a surprise. To think your orders could be this effective"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Tactic",
            "VoiceClip": "Ako_(Dress)_Tactic_Victory_2",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_tactic_victory_2",
            "LocalizeEN": "Yes, it was a perfect teamwork. Fufu, it was worth it coming to the field myself"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_Buffed_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_buffed_1",
            "LocalizeEN": "Thank you for the assistance!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_BuffSelf_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_buffself_1",
            "LocalizeJP": "さあ、活躍をお見せしましょう。",
            "LocalizeEN": "Now, let's show we're hard at work"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_Covered_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_covered_1",
            "LocalizeEN": "Fuh, I've taken cover"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_Defense_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_defense_1",
            "LocalizeEN": "It's useless!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_In_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_in_1",
            "LocalizeEN": "Fufu, kindly witness my hard work and sear them into your eyes"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_In_2",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_in_2",
            "LocalizeEN": "Now, time to execute our plans"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_Move_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_move_1",
            "LocalizeEN": "Now, shall we go?"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_Move_2",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_move_2",
            "LocalizeEN": "To the next location"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_Recovery_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_recovery_1",
            "LocalizeEN": "Ah, thank you very much!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_Retire",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_retire",
            "LocalizeJP": "わ、私が至らなかったせいで…、申し訳ありません。",
            "LocalizeEN": "Be- because I didn't take everything into account... I am deeply sorry"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_Shout_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_shout_1",
            "LocalizeJP": "撃ちます。",
            "LocalizeEN": "I'll shoot"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_TacticalAction_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_tacticalaction_1",
            "LocalizeJP": "次のポイントへ移動します",
            "LocalizeEN": "Moving to the next point"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_Victory_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_victory_1",
            "LocalizeEN": "Fufu, that was a performance befitting an administrative officer, right!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Battle",
            "VoiceClip": "Ako_(Dress)_Battle_Victory_2",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_battle_victory_2",
            "LocalizeEN": "How was it? I, worked really hard"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "CommonSkill",
            "VoiceClip": "Ako_(Dress)_CommonSkill",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_commonskill",
            "LocalizeEN": "You will not escape"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Ako_(Dress)_ExSkill_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_exskill_1",
            "LocalizeEN": "...As expected, thats how it is"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Ako_(Dress)_ExSkill_2",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_exskill_2",
            "LocalizeEN": "Everyone, file into position!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Ako_(Dress)_ExSkill_3",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_exskill_3",
            "LocalizeEN": "Remove the risk factor!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Ako_(Dress)_ExSkill_Level_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_exskill_level_1",
            "LocalizeEN": "You're surrounded, nowhere to escape!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Ako_(Dress)_ExSkill_Level_2",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_exskill_level_2",
            "LocalizeEN": "Everyone, we'll securely deal with it!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Ako_(Dress)_ExSkill_Level_3",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_exskill_level_3",
            "LocalizeJP": "風紀委員会から逃れられると思っていたんですか?",
            "LocalizeEN": "You thought you could escape from the Prefect team?"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Growup",
            "VoiceClip": "Ako_(Dress)_Growup_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_growup_1",
            "LocalizeEN": "Thanks for your continuous support... fufu"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Growup",
            "VoiceClip": "Ako_(Dress)_Growup_2",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_growup_2",
            "LocalizeEN": "I've grown yet another step. If I have became someone you can rely on, that's all I've wanted"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Growup",
            "VoiceClip": "Ako_(Dress)_Growup_3",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_growup_3",
            "LocalizeEN": "...Thank you, Sensei.\n...Just in case, I am always grateful, just so you know"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Growup",
            "VoiceClip": "Ako_(Dress)_Growup_4",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_growup_4",
            "LocalizeEN": "Yet another step foward.\nAs much as I've grown, the more I promise to become your perfect assistant"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Relationship",
            "VoiceClip": "Ako_(Dress)_Relationship_Up_1",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_relationship_up_1",
            "LocalizeEN": "Again..?\n...Just so you know, I won't get flustered by something like that. Just watch and see"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Relationship",
            "VoiceClip": "Ako_(Dress)_Relationship_Up_2",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_relationship_up_2",
            "LocalizeEN": "Ah- N, No. I'm not flustered at all. Not one bit. Even if you're closer than usual, this is nothing at all!"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Relationship",
            "VoiceClip": "Ako_(Dress)_Relationship_Up_3",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_relationship_up_3",
            "LocalizeEN": "You always get into people's hearts without them realizing it.. You... You're so unfair.. Very much unfair"
        },
        {
            "CharacterId": 10087,
            "DialogCategory": "Relationship",
            "VoiceClip": "Ako_(Dress)_Relationship_Up_4",
            "Path": "Audio/VOC_JP/JP_CH0231/ch0231_relationship_up_4",
            "LocalizeEN": "Before, just as I've told you... I dont hate you at all.\n...There's really no lies in those words, i mean it you know?"
        }
    ]
}
