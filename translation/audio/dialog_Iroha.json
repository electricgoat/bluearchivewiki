        },
        {
            "CharacterId": 20016,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Iroha_ExSkill_Level_2",
            "Path": "Audio/VOC_JP/JP_CH0156/ch0156_exskill_level_2",
            "LocalizeJP": "分かりましたよ、もう……",
            "LocalizeEN": "I got it already."
