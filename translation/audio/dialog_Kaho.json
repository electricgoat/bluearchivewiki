{
    "DataList": [
        {
            "CharacterId": 10065,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kaho_Lobby_3",
            "Path": "Audio/VOC_JP/JP_CH0107/CH0107_Lobby_3",
            "LocalizeEN": "When I find myself experiencing difficulties, I know I can always draw strength from my collection of Chise merchandise.\n\n...Shall I give you a piece, Sensei?"
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kaho_Season_Birthday_Player_2",
            "Path": "Audio/VOC_JP/JP_CH0107/CH0107_Season_Birthday_Player_2",
            "LocalizeEN": "Huh? What do you mean, too much? There's no way a mere greeting would be enough...\n\nOh, I really thought it was a good idea. Is it not? I see..."
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kaho_MemorialLobby_2_1",
            "Path": "Audio/VOC_JP/JP_CH0107/CH0107_MemorialLobby_2_1",
            "LocalizeEN": "Ah... It's a perfect, God-given shape. There's nothing better...\n\nTo see such a thing... It truly makes me grateful to be alive."
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kaho_MemorialLobby_3_1",
            "Path": "Audio/VOC_JP/JP_CH0107/CH0107_MemorialLobby_3_1",
            "LocalizeEN": "Yes, truly! They're all my cute and precious children.\n\nSee? A lovable child, a strong child, a cool child, and a beautiful child...\n\nHeehee. I see them all as if they were Hyakkiyako students."
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kaho_MemorialLobby_4_1",
            "Path": "Audio/VOC_JP/JP_CH0107/CH0107_MemorialLobby_4_1",
            "LocalizeEN": "Of course, they are all unique, and sometimes conflicts arise due to their differences.\n\nBut that's not a problem if I think of them all as precious students. Their individuality should be celebrated."
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Tactic",
            "VoiceClip": "Kaho_Tactic_Defeat_1",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_tactic_defeat_1",
            "LocalizeJP": "くっ…。作戦、失敗です。私のせいで、申し訳ありません。"
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Tactic",
            "VoiceClip": "Kaho_Tactic_Defeat_2",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_tactic_defeat_2",
            "LocalizeJP": "私がいたらないばかりに、百鬼夜行の名を汚してしまいました。…申し訳ございません。"
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Battle",
            "VoiceClip": "Kaho_Battle_BuffSelf_1",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_battle_buffself_1",
            "LocalizeJP": "より一層、励むとしましょう。"
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Battle",
            "VoiceClip": "Kaho_Battle_Covered_1",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_battle_covered_1",
            "LocalizeJP": "呼吸を整えて……"
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Battle",
            "VoiceClip": "Kaho_Battle_Retire",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_battle_retire",
            "LocalizeJP": "ここで倒れるわけには…！"
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Battle",
            "VoiceClip": "Kaho_Battle_Shout_2",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_battle_shout_2",
            "LocalizeJP": "撃ちます！"
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Growup",
            "VoiceClip": "Kaho_Growup_1",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_growup_1",
            "LocalizeEN": "Thank you very much. Sensei, I was able to grow thanks to you."
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Growup",
            "VoiceClip": "Kaho_Growup_2",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_growup_2",
            "LocalizeEN": "It's nice to be able to feel the growth."
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Growup",
            "VoiceClip": "Kaho_Growup_3",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_growup_3",
            "LocalizeEN": "Thanks to you, I became stronger again. I want to use this power to help you even more."
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Growup",
            "VoiceClip": "Kaho_Growup_4",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_growup_4",
            "LocalizeEN": "It seems like I've grown even more. I would be happy if I could be of help."
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Relationship",
            "VoiceClip": "Kaho_Relationship_Up_1",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_relationship_up_1",
            "LocalizeEN": "My heart is pounding so fast... It's the first time I've ever felt that feeling."
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Relationship",
            "VoiceClip": "Kaho_Relationship_Up_2",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_relationship_up_2",
            "LocalizeEN": "The more time we spend together, the more our hearts grow closer. I see."
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Relationship",
            "VoiceClip": "Kaho_Relationship_Up_3",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_relationship_up_3",
            "LocalizeJP": "少し、身体が熱くなってきて……。\nこれは……いえ、もしかして…うっ。",
            "LocalizeEN": "My body is getting a little hotter, and I wonder if this might be the case."
        },
        {
            "CharacterId": 10065,
            "DialogCategory": "Relationship",
            "VoiceClip": "Kaho_Relationship_Up_4",
            "Path": "Audio/VOC_JP/JP_CH0107/ch0107_relationship_up_4",
            "LocalizeEN": "This is my first time being in a position where someone is watching over me. It makes me so happy."
        }
