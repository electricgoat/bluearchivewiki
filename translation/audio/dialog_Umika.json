        {
            "CharacterId": 10090,
            "DialogCategory": "UILobby",
            "VoiceClip": "Umika_LogIn_1",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_LogIn_1",
            "LocalizeEN": "Ah, Sensei! Welcome! What should I help you with?"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobby",
            "VoiceClip": "Umika_LogIn_2",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_LogIn_2",
            "LocalizeEN": "You are here, sensei! What should we start with? I'll give it my best!"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobby",
            "VoiceClip": "Umika_Lobby_1",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_Lobby_1",
            "LocalizeEN": "Schale is an enigma, isnt it... It makes me feel excited... Like it's something out of a festival!"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobby",
            "VoiceClip": "Umika_Lobby_2",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_Lobby_2",
            "LocalizeEN": "I like seeing new and fun things. And I like being with someone while in that kind of mood as well. And being with you... Yes I like that too."
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobby",
            "VoiceClip": "Umika_Lobby_3",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_Lobby_3",
            "LocalizeEN": "Since I've came to Hyakkiyako, there's alot of new things I've learnt, and many things has changed. But, I still love festivals the most"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobby",
            "VoiceClip": "Umika_Lobby_4",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_Lobby_4",
            "LocalizeEN": "I want to learn about more things, and get better! So, sensei, please teach me all sorts of things"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobby",
            "VoiceClip": "Umika_Lobby_5",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_Lobby_5",
            "LocalizeEN": "Once I'm done with Momoyodou's works, I'll have to do the set ups for a festival, and listen to classes in between them, and also study for a test... Ugh, there's too many things to do! Eh? The same goes for SCHALE...?"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobby",
            "VoiceClip": "Umika_Season_Birthday_Player",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_Season_Birthday_Player",
            "LocalizeEN": "Sensei, I heard! that it's your birthday! Therefore, I'll guide you to a festival that is going on! There's bound to be a festival that's being held today somewhere in Kivotos!"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobby",
            "VoiceClip": "Umika_Season_Birthday",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_Season_Birthday",
            "LocalizeEN": "Yes? yes. That's right... Today is my birthday.. Ehehe. Getting wishes from you... Makes me feel quite happy"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobby",
            "VoiceClip": "Umika_Season_NewYear",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_Season_NewYear",
            "LocalizeEN": "It's a new year! Let's go to the new year festival? \"Is there such things\"? Of course there is! If not then we'll just hold one ourselves!"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobby",
            "VoiceClip": "Umika_Season_Xmas",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_Season_Xmas",
            "LocalizeEN": "Christmas... A day of festivals! We can't just stay put right here! Quick let's go out, sensei!"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobby",
            "VoiceClip": "Umika_Season_Halloween",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_Season_Halloween",
            "LocalizeEN": "Halloween is a wonderful destival isnt it! There are parades, snacks, playing disguises, and playing Trick or Treat! What kinds of costumes do you like? I'll get them all ready for you!"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "WeaponGet",
            "VoiceClip": "Umika_ExWeapon_Get",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_ExWeapon_Get",
            "LocalizeEN": "Em.. Well... Thank you so much, Sensei! I never thought I'd get something like this... I.. will do my best! Please, take care of me from now on as well!"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Umika_MemorialLobby_1",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_MemorialLobby_1",
            "LocalizeEN": "Welcome to the festival. Sensei!"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Umika_MemorialLobby_2",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_MemorialLobby_2",
            "LocalizeEN": "Ehehe, what do you think? All the preparations I was doing up to this point, was for this moment!"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Umika_MemorialLobby_3",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_MemorialLobby_3",
            "LocalizeEN": "Nobody knows of this, and I haven't invited anyone else"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Umika_MemorialLobby_4",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_MemorialLobby_4",
            "LocalizeEN": "Because this festival... Is made for you!"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Umika_MemorialLobby_5_1",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_MemorialLobby_5_1",
            "LocalizeEN": "There is nobody else, a festival with just you and me...\nIt is a bit embarrassing but... I'd be happy if you enjoy it!"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Umika_EventLogin_2",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_EventLogin_2",
            "LocalizeEN": "May you depart with cherished memories that will last a lifetime!\n\nThis is Satohama Umika here. I will give it my all!\n\nI didn't do too bad just now, did I?"
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Umika_EventLobby_1",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_EventLobby_1",
            "LocalizeEN": "Can I do this well? Am I doing well?\n\nWow... Thank you for that. I really appreciate it..."
        },
        {
            "CharacterId": 10090,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Umika_EventLobby_2",
            "Path": "Audio/VOC_JP/JP_CH0110/CH0110_EventLobby_2",
            "LocalizeEN": "Of course... If you turn everything into a festival—!\n\nHuh? I sounded like some kind of festival fiend just now? How?\n\nOh, wait a minute. A festival fiend... That could be used as the theme for..."
        },
