            "CharacterId": 10089,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Aru_(Dress)_MemorialLobby_4",
            "Path": "Audio/VOC_JP/JP_CH0240/CH0240_MemorialLobby_4",
            "LocalizeEN": "And I'm sure it's the same for you too, Sensei."
        },
