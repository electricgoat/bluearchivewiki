            "CharacterId": 10089,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Aru_(Dress)_MemorialLobby_5",
            "Path": "Audio/VOC_JP/JP_CH0240/CH0240_MemorialLobby_5",
            "LocalizeEN": "Hehe... I wonder, have I become closer to you, Sensei?"
        },
