            "CharacterId": 10089,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Aru_(Dress)_MemorialLobby_3_1",
            "Path": "Audio/VOC_JP/JP_CH0240/CH0240_MemorialLobby_3_1",
