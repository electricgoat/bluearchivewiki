{
    "DataList": [
        {
            "CharacterId": 10104,
            "DialogCategory": "UITitle",
            "VoiceClip": "Reijo_Title",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Title",
            "LocalizeEN": "Blue Archive"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "CharacterGet",
            "VoiceClip": "Reijo_Gachaget",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Gachaget",
            "LocalizeEN": "I am Kayama Reijo, the manager and bodyguard at the main branch of Black Tortoise Promenade club, Shanhaijing Secondary school. Once again, nice to meet you, Sensei"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Cafe",
            "VoiceClip": "Reijo_Cafe_Monolog_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Cafe_monolog_1",
            "LocalizeEN": "I wonder how the logistics management are done over here?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Cafe",
            "VoiceClip": "Reijo_Cafe_Monolog_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Cafe_monolog_2",
            "LocalizeEN": "Comparing this to Black Tortoise Promenade, it's a learning experience"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Cafe",
            "VoiceClip": "Reijo_Cafe_Monolog_3",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Cafe_monolog_3",
            "LocalizeEN": "Let's do some market research"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Cafe",
            "VoiceClip": "Reijo_Cafe_Monolog_4",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Cafe_monolog_4",
            "LocalizeEN": "(In order to expand Black Tortoise Promenade's market here...)"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Cafe",
            "VoiceClip": "Reijo_Cafe_Monolog_5",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Cafe_monolog_5",
            "LocalizeEN": "I'd love to secure a place where I could do some stretching..."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_LogIn_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_LogIn_1",
            "LocalizeEN": "If you have a request, feel free to ask..... Well, except for difficult things, please"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_LogIn_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_LogIn_2",
            "LocalizeEN": "I've been waiting for you, Sensei. No, no need to worry. It wasn't for that long.... I'd say."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_1_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_1_1",
            "LocalizeEN": "I have plenty experiences when it comes to managing distribution channels and transactions. I can guard and do security duties as well, to some extent"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_1_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_1_2",
            "LocalizeEN": "...What am I most confident in? Of course, it's Kung Fu!"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_2_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_2_1",
            "LocalizeEN": "I feel like moving my body for a bit. I'll go practice Kung Fu..."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_2_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_2_2",
            "LocalizeEN": "...Go for a walk? ...But just walking isn't...."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_2_3",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_2_3",
            "LocalizeEN": "Ah! No! I'll go! If it's with you!"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_3_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_3_1",
            "LocalizeEN": "Honestly, my marksmanship skills are pretty poor. So much so I've been told wouldn't it be better if I just fought using my bare hands before..."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_3_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_3_2",
            "LocalizeEN": "But, I've been putting in the work so...!"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_3_3",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_3_3",
            "LocalizeEN": "Now I can shoot... On an average skill level, I think..."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_4_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_4_1",
            "LocalizeEN": "\"It's okay to slack off every now and then\", you say...?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_4_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_4_2",
            "LocalizeEN": "No can do, Sensei! Time is gold! The march of time waits for no one you know!?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_4_3",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_4_3",
            "LocalizeEN": "...For effective time use, rest is important as well..?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_4_4",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_4_4",
            "LocalizeEN": "Certainly... You have a point there but..."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_5_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_5_1",
            "LocalizeEN": "Time alone together... Especially ones with you... It feels strange"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Lobby_5_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Lobby_5_2",
            "LocalizeEN": "Um, Sensei... May... I sit beside you...?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Season_Birthday_Player_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Season_Birthday_Player_2",
            "LocalizeEN": "Actually, I saw a rather odd dream this morning. It was about guarding the moment you were born..."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Season_Birthday_Player_3",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Season_Birthday_Player_3",
            "LocalizeEN": "...Even though at that time you weren't even in Kivotos. Quite strange, isn't it."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Season_Birthday_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Season_Birthday_1",
            "LocalizeEN": "Ah, yes!? My birthday...? You remembered..?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Season_Birthday_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Season_Birthday_2",
            "LocalizeEN": "Well... I'm very much happy that you did but...."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Season_Birthday_3",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Season_Birthday_3",
            "LocalizeEN": "... Thank you, Sensei. I am truly blessed..."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Season_NewYear_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Season_NewYear_1",
            "LocalizeEN": "Happy New Year, Sensei. I've brought you some Osechi from the Black Tortoise Promenade."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Season_NewYear_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Season_NewYear_2",
            "LocalizeEN": "I helped in making them. Fufu... Can you tell which one it is?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Season_Xmas_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Season_Xmas_1",
            "LocalizeEN": "I know very well what Christmas entails. Since I've studied it the other day."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Season_Xmas_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Season_Xmas_2",
            "LocalizeEN": "That's why, I'm going to take down the economic criminal, Santa Claus from disrupting the market prices by giving out free presents!"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobby",
            "VoiceClip": "Reijo_Season_Halloween",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_Season_Halloween",
            "LocalizeEN": "I have a grasp on what day it is. As a businesswoman, it is important for me to have a wide range of knowledge. Halloween... Is a day to profit off of pumpkins, right?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "WeaponGet",
            "VoiceClip": "Reijo_ExWeapon_Get",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_ExWeapon_Get",
            "LocalizeEN": "It is said that most problems can be solved with guns and gunpowder... But for you who gave me the push I needed...! I will find a way... To fuse the use of guns and fists together!"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Reijo_MemorialLobby_1_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_MemorialLobby_1_1",
            "LocalizeEN": "Ah, you've came.\nI'm about to be done with my morning practice, can you please wait for a bit?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Reijo_MemorialLobby_2_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_MemorialLobby_2_1",
            "LocalizeEN": "Actually, this is too, only part of a continuous motion.\nTo stop your flow, and maintain a posture, It would help in training your mind..."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Reijo_MemorialLobby_3",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_MemorialLobby_3",
            "LocalizeEN": "...Huh, why are you there, Sensei...?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Reijo_MemorialLobby_4_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_MemorialLobby_4_1",
            "LocalizeEN": "Eh? If I am in training then...\nI need to stay cool and unaffected by the stares of those around me...?\n\nThat, is true.... but...."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Reijo_MemorialLobby_5",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_MemorialLobby_5",
            "LocalizeEN": "....Ugh, n- nevermind, I can't do this!"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLogin_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLogin_1",
            "LocalizeEN": "Welcome, Sensei. The Moonlight Festival will be starting soon."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLogin_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLogin_2",
            "LocalizeEN": "Thank you for coming. Please enjoy the Moonlight Festival Shanhaijing is so proud of"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLogin_Season_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLogin_Season_1",
            "LocalizeEN": "This situation is beyond our wildest expectations but... To Genryumon, Black Tortoise Promenade, and even Shanhaijing, having your presence here is very much encouraging"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLogin_Season_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLogin_Season_2",
            "LocalizeEN": "We were able to hold the Moonlight Festival with no issues.\n...Well, about that incident, let's not think about it for now"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLogin_Season_End",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLogin_Season_End",
            "LocalizeEN": "How was the festival? Shanhaijing and Black Tortoise Promenade always have their doors open for you, Sensei"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLobby_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLobby_1",
            "LocalizeEN": "The moonlight festival is the time for Black Tortoise Promenade to show what we are made of. Sensei, please lay back"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLobby_2_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLobby_2_1",
            "LocalizeEN": "...I will answer your pranks with physical language."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLobby_2_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLobby_2_2",
            "LocalizeEN": "It's a joke, Sensei. If it's just playing around, do as you please"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLobby_2_3",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLobby_2_3",
            "LocalizeEN": "...Well, doing it too much will be an issue. So, keep it in moderation"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLobby_3_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLobby_3_1",
            "LocalizeEN": "What's the matter, Sensei? ....Eh? You just wanted to call me...?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLobby_3_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLobby_3_2",
            "LocalizeEN": "If you keep on crying wolf, it'll only be time until nobody believes you, you know?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLobby_3_3",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLobby_3_3",
            "LocalizeEN": "... I will always believe you, though."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLobby_4_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLobby_4_1",
            "LocalizeEN": "I- I'm not ticklish so even if you do tickle me.."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLobby_4_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLobby_4_2",
            "LocalizeEN": "I- I mean it. No matter what you do it's useless so, hey, sto...!"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLobby_4_3",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLobby_4_3",
            "LocalizeEN": "Aha, ahahaha!"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Reijo_EventLobby_4_4",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventLobby_4_4",
            "LocalizeEN": "...Oh, I told you to cut it out."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventShop",
            "VoiceClip": "Reijo_EventShop_LogIn_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventShop_Login_1",
            "LocalizeEN": "Running the store is down my alley. Well then... What are you looking for today?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventShop",
            "VoiceClip": "Reijo_EventShop_LogIn_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventShop_Login_2",
            "LocalizeEN": "Call out to us, and Black Tortoise Promenade will surely answer your call. \n....One day, even at the ends Kivotos!"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventShop",
            "VoiceClip": "Reijo_EventShop_End",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventShop_End",
            "LocalizeEN": "Is there nothing you forgot to get? Please, take your time so you have no regrets later on."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventShop",
            "VoiceClip": "Reijo_EventShop_1_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventShop_1_1",
            "LocalizeEN": "Black Tortoise Promenade's secret item? Secret menu...? Erm... We don't have anything like that..."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventShop",
            "VoiceClip": "Reijo_EventShop_1_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventShop_1_2",
            "LocalizeEN": "Even if you pull that face..."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventShop",
            "VoiceClip": "Reijo_EventShop_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventShop_2",
            "LocalizeEN": "If there is something you are missing, just let me know.\n....Well, except for what's sold out, I can't do anything about that"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventShop",
            "VoiceClip": "Reijo_EventShop_Buy_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventShop_Buy_1",
            "LocalizeEN": "Here, that's my recommendation item"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventShop",
            "VoiceClip": "Reijo_EventShop_Buy_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventShop_Buy_2",
            "LocalizeEN": "Take home? Or a gift?"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventShop",
            "VoiceClip": "Reijo_EventShop_Buy_3",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventShop_Buy_3",
            "LocalizeEN": "Thanks for shopping with us!\n...It's something I say all the time, but saying it to you feels new."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "UIEventShop",
            "VoiceClip": "Reijo_EventShop_Buy_4",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_EventShop_Buy_4",
            "LocalizeEN": "The president told me. If you are given a product for free, that means you are the product.\nBut, if you are a product then...\n\nAh, no, nevermind."
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Formation",
            "VoiceClip": "Reijo_Formation_In_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_formation_in_1",
            "LocalizeEN": "I humbly accept"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Formation",
            "VoiceClip": "Reijo_Formation_In_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_formation_in_2",
            "LocalizeEN": "With all that I have. I will give it my best"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Formation",
            "VoiceClip": "Reijo_Formation_Select",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_formation_select",
            "LocalizeEN": "Just like flowing water"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Tactic",
            "VoiceClip": "Reijo_Tactic_Defeat_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_tactic_defeat_1",
            "LocalizeJP": "修行が、足りませんでした……。",
            "LocalizeEN": "The training... wasn't enough"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Tactic",
            "VoiceClip": "Reijo_Tactic_Defeat_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_tactic_defeat_2",
            "LocalizeJP": "不甲斐ない",
            "LocalizeEN": "I'm useless..!"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Tactic",
            "VoiceClip": "Reijo_Tactic_In_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_tactic_in_1",
            "LocalizeEN": "Let me show you the secrets of Kung Fu"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Tactic",
            "VoiceClip": "Reijo_Tactic_In_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_tactic_in_2",
            "LocalizeEN": "Well, here I come!"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Tactic",
            "VoiceClip": "Reijo_Tactic_Victory_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_tactic_victory_1",
            "LocalizeEN": "Don't lose focus, to the last minute"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Tactic",
            "VoiceClip": "Reijo_Tactic_Victory_2",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_tactic_victory_2",
            "LocalizeEN": "With my body and soul... I'll give it my all"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Battle",
            "VoiceClip": "Reijo_Battle_Buffed_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_battle_buffed_1",
            "LocalizeEN": "I'm feeling power bursting from within!"
        },
        {
            "CharacterId": 10104,
            "DialogCategory": "Battle",
            "VoiceClip": "Reijo_Battle_BuffSelf_1",
            "Path": "Audio/VOC_JP/JP_reizyo/reizyo_battle_buffself_1",
            "LocalizeJP": "勝負はここからです！",
            "LocalizeEN": "The fight is only starting!"
        },
        {
            "CharacterId": 10104,
