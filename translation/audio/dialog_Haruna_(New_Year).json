        },
        {
            "CharacterId": 10057,
            "DialogCategory": "UIEventFortuneGachaShop",
            "VoiceClip": "Haruna_(New_Year)_Omikujipickup_1",
            "Path": "Audio/VOC_JP/JP_CH0191/CH0191_Omikujipickup_1",
            "LocalizeEN": "Oh, you drew the Great Blessing! You're quite lucky, Sensei! As to be expected.\n\nSince you drew the Great Blessing, you've won a special prize."
        },
        {
            "CharacterId": 10057,
            "DialogCategory": "UIEventFortuneGachaShop",
            "VoiceClip": "Haruna_(New_Year)_Omikujipickup_4",
            "Path": "Audio/VOC_JP/JP_CH0191/CH0191_Omikujipickup_4",
            "LocalizeEN": "You drew a Blessing. That means some good luck is coming your way.\n\nI hope you have a happy New Year."
        },
        {
            "CharacterId": 10057,
            "DialogCategory": "UIEventFortuneGachaShop",
            "VoiceClip": "Haruna_(New_Year)_Omikujipickup_2",
            "Path": "Audio/VOC_JP/JP_CH0191/CH0191_Omikujipickup_2",
            "LocalizeEN": "...You got a Modest Blessing. Here's the prize right here."
        },
        {
            "CharacterId": 10057,
            "DialogCategory": "UIEventFortuneGachaShop",
            "VoiceClip": "Haruna_(New_Year)_Omikujipickup_3",
            "Path": "Audio/VOC_JP/JP_CH0191/CH0191_Omikujipickup_3",
            "LocalizeEN": "A Small Blessing... That's not too bad.\n\nThey say to have great luck, you need to handle the little things first."
        },
        {
            "CharacterId": 10057,
            "DialogCategory": "UIEventFortuneGachaShop",
            "VoiceClip": "Haruna_(New_Year)_Omikujipickup_5",
            "Path": "Audio/VOC_JP/JP_CH0191/CH0191_Omikujipickup_5",
            "LocalizeEN": "A Future Blessing means you're sure to have good luck down the road...\n\nThat's a good sign. All right then, this way."
        },
        {
            "CharacterId": 10057,
            "DialogCategory": "UIEventFortuneGachaShop",
            "VoiceClip": "Haruna_(New_Year)_Omikujipickup_6",
            "Path": "Audio/VOC_JP/JP_CH0191/CH0191_Omikujipickup_6",
            "LocalizeEN": "It's okay. The result of the omikuji only shows your current luck.\n\nIt could turn into good fortune later...\n\nHuh? You're happy and sad that I comforted you? I-I don't understand..."
        },
