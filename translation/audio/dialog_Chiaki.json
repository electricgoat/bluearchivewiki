        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_LogIn_1",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_LogIn_1",
            "LocalizeEN": "Ah! Sensei, welcome back~!\nI'd love to hold an interview right away, can I~?"
        },
        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_LogIn_2",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_LogIn_2",
            "LocalizeEN": "Hello, Sensei~! Let's spend the day on full power again!!"
        },
        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_Lobby_1",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_Lobby_1",
            "LocalizeEN": "Yessir~! I'm Motomiya Chiaki, on standby for you~!\nDo you have any materi... anything you want me to help you with~?"
        },
        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_Lobby_2",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_Lobby_2",
            "LocalizeEN": "Have you read this week's \"Pandemonium Weekly\"?\nThe special bonus \"Cutie Ibuki chan\" bromide was simply the best!"
        },
        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_Lobby_3",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_Lobby_3",
            "LocalizeEN": "So this is Makoto senpai's pic I'm gonna use for next week's \"Pandemonium Society weekly\" and~...\n...Yes? It's too small to see you say?"
        },
        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_Lobby_4_1",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_Lobby_4_1",
            "LocalizeEN": "Sensei hard at work! Yes! Look over here please~!"
        },
        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_Lobby_4_2",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_Lobby_4_2",
            "LocalizeEN": "Your face's all stiff, you know~ Yea, relax, relax~"
        },
        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_Lobby_5",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_Lobby_5",
            "LocalizeEN": "Even as a secretary, or as a student on duty, I'll do anything you ask! Just say the word anytime, Sensei!"
        },
        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_Season_Birthday_Player",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_Season_Birthday_Player",
            "LocalizeEN": "Happy birthday, Sensei! So we're doing a special \"The day Sensei was born\" edition ! Well then, please answer these interview questions!"
        },
        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_Season_Birthday",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_Season_Birthday",
            "LocalizeEN": "Huh, come to think of it, it is my birthday isn't it. I was too focused I completely forgot about it~! Ahaha, thank you~!"
        },
        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_Season_NewYear",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_Season_NewYear",
            "LocalizeEN": "Happy New Year! You'll be our first \"Weekly Pandemonium\" reader!!"
        },
        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_Season_Xmas",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_Season_Xmas",
            "LocalizeEN": "Merry christmas~! Now now, stand right in front of that tree! I'm gonna snap a pic~!"
        },
        {
            "CharacterId": 10107,
            "DialogCategory": "UILobby",
            "VoiceClip": "Chiaki_Season_Halloween",
            "Path": "Audio/VOC_JP/JP_CH0238/CH0238_Season_Halloween",
            "LocalizeEN": "I've been looking forward to this day since forever! There's tons of people on the streets! I'll go make some buddies okay~!"
        },
