        {
            "CharacterId": 16017,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Aoba_EventLobby_1_2",
            "Path": "Audio/VOC_JP/JP_CH0288/CH0288_EventLobby_1_2",
            "LocalizeEN": "Eh... D-Did I do something wrong...?"
        },
        {
            "CharacterId": 16017,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Aoba_EventLobby_2_1",
            "Path": "Audio/VOC_JP/JP_CH0288/CH0288_EventLobby_2_1",
            "LocalizeEN": "I-I have a bad feeling..."
