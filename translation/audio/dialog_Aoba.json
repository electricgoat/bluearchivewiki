            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Aoba_EventLogin_Season_1_1",
            "Path": "Audio/VOC_JP/JP_CH0288/CH0288_EventLogin_Season_1_1",
            "LocalizeEN": "Ugh... I-It feels like this situation is becoming very annoying..."
