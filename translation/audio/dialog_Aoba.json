            "CharacterId": 16017,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Aoba_EventLogin_Season_End_2",
            "Path": "Audio/VOC_JP/JP_CH0288/CH0288_EventLogin_Season_End_2",
            "LocalizeEN": "Thank you for your h-hard work, Sensei..."
