            "CharacterId": 16017,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Aoba_EventLogin_2_1",
            "Path": "Audio/VOC_JP/JP_CH0288/CH0288_EventLogin_2_1",
            "LocalizeEN": "H-Highlander isn't always like this...! It's just that this time, it's..."
