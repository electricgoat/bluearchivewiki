            "CharacterId": 16017,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Aoba_EventLogin_Season_1_2",
            "Path": "Audio/VOC_JP/JP_CH0288/CH0288_EventLogin_Season_1_2",
            "LocalizeEN": "I'm not sure if I can trust the officers... Umm..."
