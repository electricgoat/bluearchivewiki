        {
            "CharacterId": 16017,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Aoba_EventLogin_Season_2",
            "Path": "Audio/VOC_JP/JP_CH0288/CH0288_EventLogin_Season_2",
            "LocalizeEN": "Phew... B-But it seems like things are wrapping up okay..."
        },
        {
            "CharacterId": 16017,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Aoba_EventLogin_Season_End_1",
            "Path": "Audio/VOC_JP/JP_CH0288/CH0288_EventLogin_Season_End_1",
            "LocalizeEN": "I-It's over...somehow..."
