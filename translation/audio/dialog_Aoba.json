        {
            "CharacterId": 16017,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Aoba_EventLobby_2_2",
            "Path": "Audio/VOC_JP/JP_CH0288/CH0288_EventLobby_2_2",
