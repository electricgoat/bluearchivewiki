            "CharacterId": 16017,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Aoba_EventLogin_2_2",
            "Path": "Audio/VOC_JP/JP_CH0288/CH0288_EventLogin_2_2",
            "LocalizeEN": "W-Well, actually, it is like this most of the time..."
