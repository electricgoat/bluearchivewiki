        {
            "CharacterId": 10045,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Hoshino_(Swimsuit)_MemorialLobby_2_1",
            "Path": "Audio/VOC_JP/JP_HoshinoSwimsuit/HoshinoSwimsuit_MemorialLobby_2_1",
            "LocalizeEN": "Cool shade... A comfortable breeze... The soft sound of waves...\n\nWow...! I'm glad I came here! This place is like a dream. It's the best!"
        },
        {
            "CharacterId": 10045,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Hoshino_(Swimsuit)_MemorialLobby_3_1",
            "Path": "Audio/VOC_JP/JP_HoshinoSwimsuit/HoshinoSwimsuit_MemorialLobby_3_1",
            "LocalizeEN": "...Don't just stand there, Sensei. Why don't you lie down?\n\nThere's not much room... Do you mind?"
        },
        {
            "CharacterId": 10045,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Hoshino_(Swimsuit)_MemorialLobby_5_1",
            "Path": "Audio/VOC_JP/JP_HoshinoSwimsuit/HoshinoSwimsuit_MemorialLobby_5_1",
            "LocalizeEN": "I don't mind though...\n\nSo, I guess that's why I like you.\n\n...Heeheehee."
        },
        {
            "CharacterId": 10045,
            "DialogCategory": "UIEventLobby",
