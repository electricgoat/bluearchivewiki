        {
            "CharacterId": 10069,
            "DialogCategory": "Growup",
            "VoiceClip": "Rumi_Growup_1",
            "Path": "Audio/VOC_JP/JP_CH0135/ch0135_growup_1",
            "LocalizeEN": "Hmm? Did I just, get stronger?"
        },
        {
            "CharacterId": 10069,
            "DialogCategory": "Growup",
            "VoiceClip": "Rumi_Growup_2",
            "Path": "Audio/VOC_JP/JP_CH0135/ch0135_growup_2",
            "LocalizeEN": "This feeling... yeah, it's not bad. Is it all because of Sensei?"
        },
        {
            "CharacterId": 10069,
            "DialogCategory": "Growup",
            "VoiceClip": "Rumi_Growup_3",
            "Path": "Audio/VOC_JP/JP_CH0135/ch0135_growup_3",
            "LocalizeEN": "Thank you, Sensei. Won't you come to Genbu Company soon? I'll be sure to treat you."
        },
        {
            "CharacterId": 10069,
            "DialogCategory": "Growup",
            "VoiceClip": "Rumi_Growup_4",
            "Path": "Audio/VOC_JP/JP_CH0135/ch0135_growup_4",
            "LocalizeEN": "If I've gotten stronger, that  should mean I could make even more dishes. Sensei, aren't you starving?"
        },
        {
            "CharacterId": 10069,
            "DialogCategory": "Relationship",
            "VoiceClip": "Rumi_Relationship_Up_1",
            "Path": "Audio/VOC_JP/JP_CH0135/ch0135_relationship_up_1",
            "LocalizeEN": "I may be everyone's cook, head chef, and chairwoman... but sometimes, becoming someone's special someone... is something I've been thinking about."
        },
        {
            "CharacterId": 10069,
            "DialogCategory": "Relationship",
            "VoiceClip": "Rumi_Relationship_Up_2",
            "Path": "Audio/VOC_JP/JP_CH0135/ch0135_relationship_up_2",
            "LocalizeEN": "Ah... Sorry, Sensei. I'm kinda not, used to handling these feelings. I mean, it's the first time, so."
        },
        {
            "CharacterId": 10069,
            "DialogCategory": "Relationship",
            "VoiceClip": "Rumi_Relationship_Up_3",
            "Path": "Audio/VOC_JP/JP_CH0135/ch0135_relationship_up_3",
            "LocalizeEN": "Today, I'd like to invite you out with me Sensei, so, what do you say? I'm asking not as the chairwoman, but as just a student... just me, Rumi."
        },
        {
            "CharacterId": 10069,
            "DialogCategory": "Relationship",
            "VoiceClip": "Rumi_Relationship_Up_4",
            "Path": "Audio/VOC_JP/JP_CH0135/ch0135_relationship_up_4",
            "LocalizeEN": "Responsibility can be a serious and... burdensome thing.\nAt times, you just can't help but wanting to let go. \n\nHm, thank you, Sensei, for listening to my talk."
        }
    ]
