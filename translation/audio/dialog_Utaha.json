{
    "DataList": [
        {
            "CharacterId": 23004,
            "DialogCategory": "Cafe",
            "VoiceClip": "Utaha_Cafe_Act_1",
            "Path": "Audio/VOC_JP/JP_Utaha/Utaha_Cafe_Act_1",
            "LocalizeEN": "I wonder why no one wants an active camouflage underwear. I was so proud of it too..."
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "UILobby",
            "VoiceClip": "Utaha_Lobby_2",
            "Path": "Audio/VOC_JP/JP_Utaha/Utaha_Lobby_2",
            "LocalizeEN": "..Just as I calculated. This way we can be together."
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "UILobby",
            "VoiceClip": "Utaha_Lobby_4",
            "Path": "Audio/VOC_JP/JP_Utaha/Utaha_Lobby_4",
            "LocalizeEN": "With you by our side, our we have more doors open than ever."
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "UILobby",
            "VoiceClip": "Utaha_Season_NewYear",
            "Path": "Audio/VOC_JP/JP_Utaha/Utaha_Season_NewYear",
            "LocalizeEN": "Happy New Year, Sensei.\n\nI'm going to become a kinder me this year...\n\n...thanks to you being here."
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Utaha_MemorialLobby_1_1",
            "Path": "Audio/VOC_JP/JP_Utaha/Utaha_MemorialLobby_1_1",
            "LocalizeEN": "Let's see... Judging by the gap in the axle, there may be a problem with the bearings.\n\nThe bearings must be defective or worn-down...\n\nWorse case scenario, I'll need to replace some parts altogether."
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Utaha_MemorialLobby_2_1",
            "Path": "Audio/VOC_JP/JP_Utaha/Utaha_MemorialLobby_2_1",
            "LocalizeEN": "Do you intend on staying to watch, Sensei?\n\nIt's no issue, however..."
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Utaha_MemorialLobby_3_1",
            "Path": "Audio/VOC_JP/JP_Utaha/Utaha_MemorialLobby_3_1",
            "LocalizeEN": "Engineering is dangerous work, so please observe from a safe distance.\n\nI wouldn't want you to cut yourself on any of the equipment.\n\nAnd the smell of oil will stick to your clothes for quite some time. B-But most of all...\n\nMy face is a mess because of the sweat and soot..."
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Utaha_MemorialLobby_4_1",
            "Path": "Audio/VOC_JP/JP_Utaha/Utaha_MemorialLobby_4_1",
            "LocalizeEN": "However that's irrelevant to this situation! A-Anyways... The axle...\n\nIt appears I was correct.\n\nThe bearings aren't lubricated properly, so there's a significant amount of wear-and-tear.\n\nPass me the wrench, Sensei."
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "Formation",
            "VoiceClip": "Utaha_Formation_In_1",
            "Path": "Audio/VOC_JP/JP_Utaha/utaha_formation_in_1",
            "LocalizeJP": "技術の優位こそが勝利を決定づけるんだ。",
            "LocalizeEN": "Technical superiority determines victory."
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "Formation",
            "VoiceClip": "Utaha_Formation_In_2",
            "Path": "Audio/VOC_JP/JP_Utaha/utaha_formation_in_2",
            "LocalizeEN": "It's a reasonable choice."
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "Battle",
            "VoiceClip": "Utaha_Battle_TSA_1",
            "Path": "Audio/VOC_JP/JP_Utaha/utaha_battle_tsa_1",
            "LocalizeJP": "このヘリを最初に作ったのは、中学生の時だったな。",
            "LocalizeEN": "The first time I made this helicopter was when I was in middle school."
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "Battle",
            "VoiceClip": "Utaha_Battle_TSA_2",
            "Path": "Audio/VOC_JP/JP_Utaha/utaha_battle_tsa_2",
            "LocalizeJP": "よく見ておいて。エンジニア部の力は重機だけでは説明できないから。",
            "LocalizeEN": "Look closely, the power of the Engineering Department cannot be explained by heavy machinery alone."
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "CommonSkill",
            "VoiceClip": "Utaha_CommonSkill",
            "Path": "Audio/VOC_JP/JP_Utaha/utaha_commonskill",
            "LocalizeJP": "雷（いかずち）の玉座……。\n戦闘モード！",
            "LocalizeEN": "Thundergun, combat mode"
        },
        {
            "CharacterId": 23004,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Utaha_ExSkill_1",
            "Path": "Audio/VOC_JP/JP_Utaha/utaha_exskill_1",
            "LocalizeEN": "Go on a rampage."
        },
        {
