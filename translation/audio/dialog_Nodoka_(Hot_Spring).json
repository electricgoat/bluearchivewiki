{
    "DataList": [
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_1",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_1",
            "LocalizeJP": "227号温泉郷へようこそ！これより、営業を開始いたします！"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_2",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_2",
            "LocalizeJP": "お部屋のご準備が出来ましたので、どうぞ、ごゆるりとお過ごしくださいませ！"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_3",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_3",
            "LocalizeJP": "お料理の準備が出来ました！お腹が空かれた方は、宴会場までお越しくださいませ！"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_4",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_4",
            "LocalizeJP": "露天風呂の準備が出来ました！どうぞお楽しみください！"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_5",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_5",
            "LocalizeJP": "この227号温泉郷には、素敵な庭園もあるんです。お風呂上りに、庭園でお散歩などいかがですか？"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_Act_1",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_act_1",
            "LocalizeJP": "何かお困りの点などはございませんか？"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_Act_2",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_act_2",
            "LocalizeJP": "何かありましたら、女将である、この私に！いつでもお申し付けください！"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_Act_3",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_act_3",
            "LocalizeJP": "シグレちゃん、勝手にお客様に飲み物を勧めないように！"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_Act_4",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_act_4",
            "LocalizeJP": "湯加減はいかがですか、お客様？"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_Act_5",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_act_5",
            "LocalizeJP": "すぐにお片付けいたしますので、少々お待ちください…！"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_Act_6",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_act_6",
            "LocalizeJP": "埃ひとつ残さないよう、隅々まで綺麗に…！"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_Act_7",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_act_7",
            "LocalizeJP": "この227号温泉郷では、最高級の寝具を揃えております。旧校舎とはぜぇんぜん！違うんですよ！"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_Act_8",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_act_8",
            "LocalizeJP": "最高級の懐石料理をご用意いたしましたので、思う存分ご堪能ください！"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Nodoka_(Hot_Spring)_EventLocation_Act_9",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_eventlocation_act_9",
            "LocalizeJP": "危ないですので草花にお手は触れぬよう、ご注意いただきつつ、ごゆっくりとお楽しみください！"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "Formation",
            "VoiceClip": "Nodoka_(Hot_Spring)_Formation_In_1",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_formation_in_1",
            "LocalizeJP": "女将の真髄、お見せします。",
            "LocalizeEN": "I will show you the essence of being a proprietress."
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "Formation",
            "VoiceClip": "Nodoka_(Hot_Spring)_Formation_In_2",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_formation_in_2",
            "LocalizeJP": "ぜ、全力でおもてなしします。",
            "LocalizeEN": "I will do my best to serve you."
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "CommonSkill",
            "VoiceClip": "Nodoka_(Hot_Spring)_CommonSkill",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_commonskill",
            "LocalizeEN": "Is there anything I can help you with, dear customer?"
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Nodoka_(Hot_Spring)_ExSkill_1",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_exskill_1",
            "LocalizeEN": "This is the [[w:kaiseki|kaiseki]] of No. 227 Hot Spring Resort."
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Nodoka_(Hot_Spring)_ExSkill_2",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_exskill_2",
            "LocalizeEN": "It is a dish that I'm proud of."
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Nodoka_(Hot_Spring)_ExSkill_3",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_exskill_3",
            "LocalizeEN": "Full of luxurious ingredients."
        },
        {
            "CharacterId": 20010,
            "DialogCategory": "ExSkill",
