        },
        {
            "CharacterId": 20010,
            "DialogCategory": "Growup",
            "VoiceClip": "Nodoka_(Hot_Spring)_Growup_2",
            "Path": "Audio/VOC_JP/JP_CH0165/ch0165_growup_2",
