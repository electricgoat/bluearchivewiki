        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_Shout_2",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_shout_2",
            "LocalizeJP": "はぁっ！"
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_Shout_3",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_shout_3",
            "LocalizeJP": "やっ！"
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_TacticalAction_1",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_tacticalaction_1",
            "LocalizeEN": "Moving to a more advantageous position."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_Victory_1",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_victory_1",
            "LocalizeEN": "For Hyakkaryouran's strategist, victory is a given."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_Victory_2",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_victory_2",
            "LocalizeEN": "Because it's a matter of course to win."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "CommonSkill",
            "VoiceClip": "Kikyou_CommonSkill",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_commonskill",
            "LocalizeEN": "Consult this."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Kikyou_ExSkill_2",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_exskill_2",
            "LocalizeEN": "A decisive move to shake up the battle!"
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Kikyou_ExSkill_3",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_exskill_3",
            "LocalizeEN": "There is only one thing to do."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Kikyou_ExSkill_Level_1",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_exskill_level_1",
            "LocalizeEN": "There!"
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Kikyou_ExSkill_Level_2",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_exskill_level_2",
            "LocalizeEN": "I won't hold back. I'm going to give it my all!"
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Kikyou_ExSkill_Level_3",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_exskill_level_3",
            "LocalizeEN": "Enjoy Hyakkaryouran's power to the fullest."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Growup",
            "VoiceClip": "Kikyou_Growup_1",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_growup_1",
            "LocalizeEN": "What do you expect in return for giving me this? After all, that's what a transaction is, isn't it?"
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Growup",
            "VoiceClip": "Kikyou_Growup_2",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_growup_2",
            "LocalizeEN": "I don't know what you're scheming, but I won't refuse if you're offering."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Growup",
            "VoiceClip": "Kikyou_Growup_3",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_growup_3",
            "LocalizeEN": "Even after being told that, you're still doing this... You're truly a weird person."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Growup",
            "VoiceClip": "Kikyou_Growup_4",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_growup_4",
            "LocalizeEN": "Thanks to you, I've grown. I'm not denying it. This is an objective fact. So, at the very least, I'll say thank you."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Relationship",
            "VoiceClip": "Kikyou_Relationship_Up_1",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_relationship_up_1",
            "LocalizeEN": "Sensei, you're too close. I'm not saying I dislike it."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Relationship",
            "VoiceClip": "Kikyou_Relationship_Up_2",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_relationship_up_2",
            "LocalizeEN": "Ah, Sensei. Where have you been? Stay where I can see you."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Relationship",
            "VoiceClip": "Kikyou_Relationship_Up_3",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_relationship_up_3",
            "LocalizeEN": "I've received Sensei's kindness. Now it's my turn. Be prepared."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Relationship",
            "VoiceClip": "Kikyou_Relationship_Up_4",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_relationship_up_4",
            "LocalizeEN": "It's true that I rely on you. So promise me: you'll rely on me too."
        }
    ]
}
