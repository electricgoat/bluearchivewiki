            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_damage_1",
            "LocalizeJP": "うっ。"
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_Damage_2",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_damage_2",
            "LocalizeJP": "ぐふっ。"
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_Damage_3",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_damage_3",
            "LocalizeJP": "ぬっ。"
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_Defense_1",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_defense_1",
            "LocalizeEN": "It doesn't work."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_In_1",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_in_1",
            "LocalizeEN": "I will take the lead as this is an operation I planned."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_In_2",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_in_2",
            "LocalizeEN": "Sear into your eyes the prowess of Hyakkaryouran."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_Move_1",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_move_1",
            "LocalizeEN": "Ready. Moving on to the next position."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_Move_2",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_move_2",
            "LocalizeEN": "The battle is going as planned. No need to worry."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_Recovery_1",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_recovery_1",
            "LocalizeEN": "Thank you. That helped."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_Retire",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_retire",
            "LocalizeJP": "退散なんて、ありえない……。",
            "LocalizeEN": "There's no way I'm retreating..."
        },
        {
            "CharacterId": 10083,
            "DialogCategory": "Battle",
            "VoiceClip": "Kikyou_Battle_Shout_1",
            "Path": "Audio/VOC_JP/JP_CH0225/ch0225_battle_shout_1",
