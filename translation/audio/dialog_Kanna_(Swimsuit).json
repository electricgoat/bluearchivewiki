        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_Season_Birthday_Player_2",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_Season_Birthday_Player_2",
            "LocalizeEN": "I will keep you safe."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_Season_Birthday",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_Season_Birthday",
            "LocalizeEN": "Oh, it's my birthday already. I don't think it's too different from the usual..."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_Season_NewYear",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_Season_NewYear",
            "LocalizeEN": "Another new year has dawned. I hope there will be no accidents this year."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_Season_Xmas_1",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_Season_Xmas_1",
            "LocalizeEN": "It's the days that people are being the most festive that we lifesavers need to be most attentive"
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_Season_Xmas_2",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_Season_Xmas_2",
            "LocalizeEN": "But... Enjoying a simple cup of coffee with you, shouldn't hurt right."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_Season_Halloween_1",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_Season_Halloween_1",
            "LocalizeEN": "I am not a big fan of candies..."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_Season_Halloween_2",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_Season_Halloween_2",
            "LocalizeEN": "Huh? So you'll... play a prank...? As long as it's nothing dangerous I don't mind but... If you're doing it just... keep it to just me, alright."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "WeaponGet",
            "VoiceClip": "Kanna_(Swimsuit)_ExWeapon_Get",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_ExWeapon_Get",
            "LocalizeEN": "A sign of trust given to me by Sensei... I see. Being a lifesaver is a heavy responsibility. I will do my best not to disappoint you."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kanna_(Swimsuit)_MemorialLobby_1",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_MemorialLobby_1",
            "LocalizeEN": "Phew...  Feels like the fatigue is gone, indeed."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kanna_(Swimsuit)_MemorialLobby_2_1",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_MemorialLobby_2_1",
            "LocalizeEN": "It's all right. This is one of the inspection items. \nBesides, hardworking people should be rewarded."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kanna_(Swimsuit)_MemorialLobby_3_1",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_MemorialLobby_3_1",
            "LocalizeEN": "And also because you have always been very helpful to me.\nSo this is a small gift... from me to you, Sensei."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kanna_(Swimsuit)_MemorialLobby_4",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_MemorialLobby_4",
            "LocalizeEN": "Huh!? Th-That cannot be true!"
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kanna_(Swimsuit)_MemorialLobby_5_1",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_MemorialLobby_5_1",
            "LocalizeEN": "I am here to, umm...\nTo keep you safe, Sensei! I am a lifesaver after all!"
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Kanna_(Swimsuit)_EventLogin_1",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_EventLogin_1",
            "LocalizeEN": "I have been waiting for you, Sensei. Have you done your warm ups?"
        },
