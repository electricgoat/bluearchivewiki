            "CharacterId": 10096,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Kanna_(Swimsuit)_EventLogin_2",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_EventLogin_2",
