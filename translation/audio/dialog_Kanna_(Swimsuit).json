            "VoiceClip": "Kanna_(Swimsuit)_EventLobby_4_2",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_EventLobby_4_2",
            "LocalizeEN": "Ahem... Guess I still can't get used to it much."
        },
