        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_LogIn_2_1",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_LogIn_2_1",
            "LocalizeEN": "Welcome, Sensei. From now on, I will be responsible for the water safety of Schale."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_LogIn_2_2",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_LogIn_2_2",
            "LocalizeEN": "Huh? There is no pool here...?"
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_Lobby_1",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_Lobby_1",
            "LocalizeEN": "I am not very used to wearing swimsuits... I apologize if I look unflattering."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_Lobby_2",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_Lobby_2",
            "LocalizeEN": "Accidents happen when you least expect them. We are always on the lookout for ways to deal with them immediately."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_Lobby_3",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_Lobby_3",
            "LocalizeEN": "Coffee? I only have one cup because it gets in the way."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_Lobby_4",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_Lobby_4",
            "LocalizeEN": "Putting life saving aside, I'm not the most confident in handling customers nor at guiding them..."
        },
        {
            "CharacterId": 10096,
            "DialogCategory": "UILobby",
            "VoiceClip": "Kanna_(Swimsuit)_Lobby_5",
            "Path": "Audio/VOC_JP/JP_CH0260/CH0260_Lobby_5",
            "LocalizeEN": "When you're getting sleepy, it's best to start moving your body.\nNow, get up. I will teach you some lifesaver-style warm up exercises."
        },
        {
