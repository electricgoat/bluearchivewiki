            "LocalizeEN": "What? Heatstroke...? I'm sorry... Sensei."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Battle",
            "VoiceClip": "Hina_(Swimsuit)_Battle_Shout_2",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_battle_shout_2",
