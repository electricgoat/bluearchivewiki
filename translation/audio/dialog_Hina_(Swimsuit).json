            "LocalizeEN": "You won't get away."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Battle",
            "VoiceClip": "Hina_(Swimsuit)_Battle_TacticalAction_1",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_battle_tacticalaction_1",
            "LocalizeEN": "Moving ahead."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Battle",
            "VoiceClip": "Hina_(Swimsuit)_Battle_Victory_1",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_battle_victory_1",
            "LocalizeEN": "Operation success. Ummm... don't stare at me so much."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Battle",
            "VoiceClip": "Hina_(Swimsuit)_Battle_Victory_2",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_battle_victory_2",
            "LocalizeEN": "This wasn't a big deal... so stop looking at me like that!"
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "CommonSkill",
            "VoiceClip": "Hina_(Swimsuit)_CommonSkill",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_commonskill",
            "LocalizeEN": "There!"
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Hina_(Swimsuit)_ExSkill_1",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_exskill_1",
            "LocalizeEN": "It's up to me to maintain discipline on the beach!"
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Hina_(Swimsuit)_ExSkill_2",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_exskill_2",
            "LocalizeEN": "It can't be helped... it'll be done by force!"
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Hina_(Swimsuit)_ExSkill_3",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_exskill_3",
            "LocalizeEN": "So it's up to me..."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Hina_(Swimsuit)_ExSkill_Level_1",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_exskill_level_1",
            "LocalizeEN": "Would you give up already?"
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Hina_(Swimsuit)_ExSkill_Level_2",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_exskill_level_2",
            "LocalizeEN": "You won't escape."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "ExSkill",
            "VoiceClip": "Hina_(Swimsuit)_ExSkill_Level_3",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_exskill_level_3",
            "LocalizeEN": "Training or not, I'll show no mercy."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Growup",
            "VoiceClip": "Hina_(Swimsuit)_Growup_2",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_growup_2",
            "LocalizeEN": "Call me whenever you need my help, even if I'm wearing this..."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Growup",
            "VoiceClip": "Hina_(Swimsuit)_Growup_3",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_growup_3",
            "LocalizeEN": "I can still be stronger. I want to be stronger for Sensei."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Growup",
            "VoiceClip": "Hina_(Swimsuit)_Growup_4",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_growup_4",
            "LocalizeEN": "Thanks as always. You know I'd be glad if you relied on me a little more..."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Relationship",
            "VoiceClip": "Hina_(Swimsuit)_Relationship_Up_1",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_relationship_up_1",
            "LocalizeEN": "It looks like I'm spending another summer with Sensei."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Relationship",
            "VoiceClip": "Hina_(Swimsuit)_Relationship_Up_2",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_relationship_up_2",
            "LocalizeEN": "Are you really fine spending time with a boring kid like me, even though it's summer? You... want to spend it with me?! I... I see."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Relationship",
            "VoiceClip": "Hina_(Swimsuit)_Relationship_Up_3",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_relationship_up_3",
            "LocalizeEN": "C-could you move away a little! I know it's just us but... it's a little embarrassing, dressed like this."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Relationship",
            "VoiceClip": "Hina_(Swimsuit)_Relationship_Up_4",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_relationship_up_4",
            "LocalizeEN": "Sensei's hands are cool and comfortable. It's so sunny outside and, can I... just a little longer?"
        }
    ]
}
