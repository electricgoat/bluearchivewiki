            "LocalizeEN": "Oh please."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Battle",
            "VoiceClip": "Hina_(Swimsuit)_Battle_Damage_3",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_battle_damage_3",
            "LocalizeJP": "これぐらい。",
            "LocalizeEN": "Is that all?"
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Battle",
            "VoiceClip": "Hina_(Swimsuit)_Battle_Defense_1",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_battle_defense_1",
            "LocalizeEN": "Pointless."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Battle",
            "VoiceClip": "Hina_(Swimsuit)_Battle_In_2",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_battle_in_2",
