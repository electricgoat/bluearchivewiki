{
    "DataList": [
        {
            "CharacterId": 10022,
            "DialogCategory": "Cafe",
            "VoiceClip": "Hina_(Swimsuit)_Cafe_Monolog_5",
            "Path": "Audio/VOC_JP/JP_CH0063/CH0063_Cafe_monolog_5",
            "LocalizeEN": "Perhaps I should plan my next session for here."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "UILobby",
            "VoiceClip": "Hina_(Swimsuit)_LogIn_2",
            "Path": "Audio/VOC_JP/JP_CH0063/CH0063_LogIn_2",
            "LocalizeEN": "I'm looking forward to the summer.\n\nDon't look at me like that, please."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "UILobby",
            "VoiceClip": "Hina_(Swimsuit)_Lobby_1",
            "Path": "Audio/VOC_JP/JP_CH0063/CH0063_Lobby_1",
            "LocalizeEN": "My swimsuit? It's my summer training uniform."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "UILobby",
            "VoiceClip": "Hina_(Swimsuit)_Lobby_2",
            "Path": "Audio/VOC_JP/JP_CH0063/CH0063_Lobby_2",
            "LocalizeEN": "No, I didn't hold particularly high hopes for this summer.\n\n...Mostly."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "UILobby",
            "VoiceClip": "Hina_(Swimsuit)_Lobby_4",
            "Path": "Audio/VOC_JP/JP_CH0063/CH0063_Lobby_4",
            "LocalizeEN": "You want me to ask for help when I need it?\n\nThank you, Sensei. You always know what to say."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "UILobby",
            "VoiceClip": "Hina_(Swimsuit)_Lobby_5",
            "Path": "Audio/VOC_JP/JP_CH0063/CH0063_Lobby_5",
            "LocalizeEN": "Please accept my support this summer, Sensei.\n\nI'll be there until the end."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "UILobby",
            "VoiceClip": "Hina_(Swimsuit)_Season_Birthday_Player",
            "Path": "Audio/VOC_JP/JP_CH0063/CH0063_Season_Birthday_Player",
            "LocalizeEN": "It's your birthday today, Sensei?\n\nLet's see... Have any gifts in mind?\n\nA walk on the beach? Heehee. Sure if that's what you want."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "UILobby",
            "VoiceClip": "Hina_(Swimsuit)_Season_Birthday_2",
            "Path": "Audio/VOC_JP/JP_CH0063/CH0063_Season_Birthday_2",
            "LocalizeEN": "You want to go in the water, together?\n\nS-Sensei, wait. I'm not ready!"
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "UILobby",
            "VoiceClip": "Hina_(Swimsuit)_Season_Halloween",
            "Path": "Audio/VOC_JP/JP_CH0063/CH0063_Season_Halloween",
            "LocalizeEN": "Oh, Halloween? I've never really participated...\n\nEveryone seems so lively spending summer on the beach."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Hina_(Swimsuit)_MemorialLobby_3_1",
            "Path": "Audio/VOC_JP/JP_CH0063/CH0063_MemorialLobby_3_1",
            "LocalizeEN": "I find it eerie... The way the sea is just a bottomless well at night.\n\nI hate how it feels like I'll be sucked in just looking at it."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Hina_(Swimsuit)_MemorialLobby_5_1",
            "Path": "Audio/VOC_JP/JP_CH0063/CH0063_MemorialLobby_5_1",
            "LocalizeEN": "It's a new feeling but it's interesting too.\n\nThank you, Sensei...for being here with me.\n\nAnd for everything you've taught me."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Formation",
            "VoiceClip": "Hina_(Swimsuit)_Formation_In_1",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_formation_in_1",
            "LocalizeEN": "To battle? Understood."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Formation",
            "VoiceClip": "Hina_(Swimsuit)_Formation_In_2",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_formation_in_2",
            "LocalizeEN": "Preparations are complete here."
        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Formation",
            "VoiceClip": "Hina_(Swimsuit)_Formation_Select",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_formation_select",
            "LocalizeEN": "Hm? What should I do now?"
        },
        {
