        },
        {
            "CharacterId": 10022,
            "DialogCategory": "Battle",
            "VoiceClip": "Hina_(Swimsuit)_Battle_Move_2",
            "Path": "Audio/VOC_JP/JP_CH0063/ch0063_battle_move_2",
