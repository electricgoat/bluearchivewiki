{
    "DataList": [
        {
            "CharacterId": 16002,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kotori_MemorialLobby_2_1",
            "Path": "Audio/VOC_JP/JP_Kotori/Kotori_MemorialLobby_2_1",
            "LocalizeEN": "...So I DID hear you correctly. Um... Okay, so... Something about me...\n\nWhat am I supposed to say here...?\n\nA-And what is the reasoning behind your line of questioning? I can't fathom the logic!"
        },
        {
            "CharacterId": 16002,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kotori_MemorialLobby_3_1",
            "Path": "Audio/VOC_JP/JP_Kotori/Kotori_MemorialLobby_3_1",
            "LocalizeEN": "Oh, uh, not that you need a specific reason or anything!\n\n...Huh? O-Of course I can answer your question! Talking about myself should be easy...\n\nS-So, something, something about me?! In my free time, I like to... Um...\n\nWell...! I like researching! And learning new things! And thinking about you, and...!"
        },
        {
            "CharacterId": 16002,
            "DialogCategory": "UILobbySpecial",
            "VoiceClip": "Kotori_MemorialLobby_4_1",
            "Path": "Audio/VOC_JP/JP_Kotori/Kotori_MemorialLobby_4_1",
            "LocalizeEN": "...? Wait. Wh-What did I just say...?\n\nThat I like learning new things, and thinking about you...?"
        },
        {
            "CharacterId": 16002,
            "DialogCategory": "Formation",
            "VoiceClip": "Kotori_Formation_In_1",
            "Path": "Audio/VOC_JP/JP_Kotori/kotori_formation_in_1",
            "LocalizeEN": "It's my turn."
        },
        {
