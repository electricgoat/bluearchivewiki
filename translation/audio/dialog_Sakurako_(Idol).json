        {
            "CharacterId": 10106,
            "DialogCategory": "Growup",
            "VoiceClip": "Sakurako_(Idol)_Growup_2",
            "Path": "Audio/VOC_JP/JP_CH0274/ch0274_growup_2",
            "LocalizeEN": "Thank you so much, Sensei.\nNext time... What should I give back to you?"
