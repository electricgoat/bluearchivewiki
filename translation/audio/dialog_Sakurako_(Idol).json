        {
            "CharacterId": 10106,
            "DialogCategory": "Growup",
            "VoiceClip": "Sakurako_(Idol)_Growup_3",
            "Path": "Audio/VOC_JP/JP_CH0274/ch0274_growup_3",
            "LocalizeEN": "I feel like power is overflowing in me.\nUm... I feel like saying it like that is kind of misleading."
        },
        {
            "CharacterId": 10106,
            "DialogCategory": "Growup",
            "VoiceClip": "Sakurako_(Idol)_Growup_4",
            "Path": "Audio/VOC_JP/JP_CH0274/ch0274_growup_4",
            "LocalizeEN": "Every day, I've been focusing so much...\nIt's good to get support from someone once in a while."
        },
        {
            "CharacterId": 10106,
            "DialogCategory": "Relationship",
            "VoiceClip": "Sakurako_(Idol)_Relationship_Up_1",
            "Path": "Audio/VOC_JP/JP_CH0274/ch0274_relationship_up_1",
