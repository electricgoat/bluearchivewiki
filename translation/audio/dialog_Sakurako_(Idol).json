            "CharacterId": 10106,
            "DialogCategory": "Relationship",
            "VoiceClip": "Sakurako_(Idol)_Relationship_Up_4",
            "Path": "Audio/VOC_JP/JP_CH0274/ch0274_relationship_up_4",
