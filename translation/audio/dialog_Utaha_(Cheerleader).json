            "DialogCategory": "Tactic",
            "VoiceClip": "Utaha_(Cheerleader)_Tactic_Defeat_1",
            "Path": "Audio/VOC_JP/JP_CH0182/ch0182_tactic_defeat_1",
            "LocalizeJP": "く…、惜しかったね。",
            "LocalizeEN": "It was a pity."
        },
