{
    "DataList": [
        {
            "CharacterId": 10051,
            "DialogCategory": "Cafe",
            "VoiceClip": "Utaha_(Cheerleader)_Cafe_Monolog_2",
            "Path": "Audio/VOC_JP/JP_CH0182/CH0182_Cafe_monolog_2",
            "LocalizeEN": "Cheers up high!\nDon't be shy!\nIf we try,\nwe'll reach the sky!\n...I'll have to iterate on this cheer."
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "Cafe",
            "VoiceClip": "Utaha_(Cheerleader)_Cafe_Monolog_3",
            "Path": "Audio/VOC_JP/JP_CH0182/CH0182_Cafe_monolog_3",
            "LocalizeEN": "A game this big is the perfect opportunity for a cheer that's even bigger!"
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "Cafe",
            "VoiceClip": "Utaha_(Cheerleader)_Cafe_Monolog_4",
            "Path": "Audio/VOC_JP/JP_CH0182/CH0182_Cafe_monolog_4",
            "LocalizeEN": "(Heehee, I'm giddy just thinking about this cheer.)"
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "Cafe",
            "VoiceClip": "Utaha_(Cheerleader)_Cafe_Monolog_5",
            "Path": "Audio/VOC_JP/JP_CH0182/CH0182_Cafe_monolog_5",
            "LocalizeEN": "We need more...spirit oomph."
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "WeaponGet",
            "VoiceClip": "Utaha_(Cheerleader)_ExWeapon_Get",
            "Path": "Audio/VOC_JP/JP_CH0182/CH0182_ExWeapon_Get",
            "LocalizeEN": "Being filled with passion\nis a meister's fashion.\nWithout inner motivation,\nwe'd be stuck in stagnation!\n...This is how I wake myself up now."
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Utaha_(Cheerleader)_EventLobby_1_1",
            "Path": "Audio/VOC_JP/JP_CH0182/CH0182_EventLobby_1_1",
            "LocalizeEN": "My cheers still need fine-tuning...\n\nBut in both cheering and engineering, trial and error need adhering! ...I'll do my best."
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Utaha_(Cheerleader)_EventLobby_1_2",
            "Path": "Audio/VOC_JP/JP_CH0182/CH0182_EventLobby_1_2",
            "LocalizeEN": "A request received will become a design achieved!\n\nThat is the eternal motto (WIP) of the Engineering Department!"
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Utaha_(Cheerleader)_EventLobby_4",
            "Path": "Audio/VOC_JP/JP_CH0182/CH0182_EventLobby_4",
            "LocalizeEN": "I get that we're not an athletics club,\n\nbut I didn't think Kotori and Hibiki would be this out of shape..."
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "UIEventLobby",
            "VoiceClip": "Utaha_(Cheerleader)_EventLobby_4_2",
            "Path": "Audio/VOC_JP/JP_CH0182/CH0182_EventLobby_4_2",
            "LocalizeJP": "祭りが終わったら、\nエンジニア部の部室に\n\n体づくりサポートの\nロボットでも作って\n置いておこうかな。\n\n体づくりサポートの\nロボットでも作って\n置いておこうかな。",
            "LocalizeEN": "There's only one way to get fit. Our club's next undertaking will be...\n\n...designing an exercise robot.\n\n...designing an exercise robot."
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Utaha_(Cheerleader)_EventLocation_1",
            "Path": "Audio/VOC_JP/JP_CH0182/ch0182_eventlocation_1",
            "LocalizeJP": "陸上トラックの整備も終わったみたいだね、それでは雷ちゃんの走行機能のテストをしようか。",
            "LocalizeEN": "Looks like the maintenance of the land truck is finished, so let's test Ikazuchi-chan's driving function."
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Utaha_(Cheerleader)_EventLocation_2",
            "Path": "Audio/VOC_JP/JP_CH0182/ch0182_eventlocation_2",
            "LocalizeJP": "綺麗に整ったフィールドだね。踏むのが申し訳なく思えるくらいだ。…おや？まさかこの芝生…、人工？",
            "LocalizeEN": "It's a beautifully arranged field. I almost feel sorry for stepping on it. ...Oh? Is this lawn...artificial?"
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Utaha_(Cheerleader)_EventLocation_3",
            "Path": "Audio/VOC_JP/JP_CH0182/ch0182_eventlocation_3",
            "LocalizeJP": "アスレチックスタジアムの倉庫もなかなかいいね、ロボットの緊急修理のときに学園まで戻らなくて済みそう。",
            "LocalizeEN": "The warehouse at Athletic Stadium is also quite nice. Looks like I won't have to go back to the school when the robot needs emergency repairs."
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Utaha_(Cheerleader)_EventLocation_Act_1",
            "Path": "Audio/VOC_JP/JP_CH0182/ch0182_eventlocation_act_1",
            "LocalizeJP": "さあ、みんな。もっと情熱をこめて、お腹から声を出して！",
            "LocalizeEN": "Come on, everyone. Put more passion into it and let your voice come out from your stomach!"
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "EventLocation",
            "VoiceClip": "Utaha_(Cheerleader)_EventLocation_Act_2",
            "Path": "Audio/VOC_JP/JP_CH0182/ch0182_eventlocation_act_2",
            "LocalizeJP": "うん、悪くないね。でも、私ならここにステップドリルを追加するかな。なにせ、ドリルはロマンだからね。",
            "LocalizeEN": "Yeah, it's not bad. But I would probably add a step drill here. After all, drills are romantic."
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "Formation",
            "VoiceClip": "Utaha_(Cheerleader)_Formation_In_1",
            "Path": "Audio/VOC_JP/JP_CH0182/ch0182_formation_in_1",
            "LocalizeEN": "I can smell the passion from somewhere."
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "Formation",
            "VoiceClip": "Utaha_(Cheerleader)_Formation_In_2",
            "Path": "Audio/VOC_JP/JP_CH0182/ch0182_formation_in_2",
            "LocalizeEN": "Having hot passion is one of the rules of a master"
        },
        {
            "CharacterId": 10051,
            "DialogCategory": "Formation",
            "VoiceClip": "Utaha_(Cheerleader)_Formation_Select",
            "Path": "Audio/VOC_JP/JP_CH0182/ch0182_formation_select",
            "LocalizeEN": "Do you need my support?"
        },
        {
